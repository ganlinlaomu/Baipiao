{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-nostr-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayDurableObject"
      }
    ]
  },
  "exports": {
    "RelayDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["ADMIN_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
